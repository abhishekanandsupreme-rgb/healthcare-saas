# Healthcare SaaS Backend Environment Variables
# Copy this file to .env and fill in real values

# Database
DATABASE_URL="postgresql://healthcare:healthcare_password@postgres:5433/healthcare_saas?schema=public"

# JWT
JWT_SECRET="replace-with-production-secret"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV="production"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Audit
AUDIT_RETENTION_DAYS=2190