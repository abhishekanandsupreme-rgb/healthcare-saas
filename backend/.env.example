# Environment Variables
NODE_ENV=development

# Application
PORT=3001
APP_NAME="Healthcare SaaS Backend"
APP_VERSION=1.0.0

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/healthcare_saas?schema=public"

# Authentication
JWT_SECRET=your-secret-key-minimum-32-characters-change-in-production
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=healthcare-saas
JWT_AUDIENCE=healthcare-saas-api

# Password Hashing (bcrypt)
BCRYPT_ROUNDS=12

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# HIPAA Compliance
AUDIT_LOG_RETENTION_DAYS=2190  # 6 years minimum per HIPAA
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_ENCRYPTION_KEY=your-32-char-encryption-key

# Encryption
ENCRYPTION_KEY=your-32-char-encryption-key-for-phi

# PHI Protection
PHI_ENCRYPTION_ENABLED=true
PHI_FIELD_ENCRYPTION=true

# Session
SESSION_SECRET=your-session-secret-minimum-32-characters
SESSION_MAX_AGE=86400000

# Optional: External Services
# SMTP for notifications (if needed)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional: Monitoring
# SENTRY_DSN=
# DATADOG_API_KEY=
